# Copy this file to .env, then enter the real values.  Never commit .env.
BOT_ENV=dev

MAIN_BOT_TOKEN=
ADMIN_BOT_TOKEN=
DEV_BOT_TOKEN=

# Comma-separated Telegram user IDs. ADMIN_IDS must contain at least one ID.
ADMIN_IDS=123456789
DEV_IDS=

DEV_CHANNEL_ID=
BACKUP_CHANNEL_ID=

# Optional project-relative paths. Forward slashes work on both Windows/Linux.
# DB_PATH=config/bot_structure.db
# ANALYTICS_DEAD_LETTER_PATH=logs/analytics_dead_letters.jsonl
# Container example with a mounted persistent volume:
# DB_PATH=/data/bot_structure.db
# ANALYTICS_DEAD_LETTER_PATH=/data/analytics_dead_letters.jsonl

# Optional backup settings.
# BACKUP_INTERVAL_HOURS=6
# BACKUP_RETENTION_DAILY=7
# BACKUP_RETENTION_WEEKLY=4
# BACKUP_RETENTION_MONTHLY=12
